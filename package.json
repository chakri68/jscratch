{
  "name": "jscratch",
  "displayName": "JScratch",
  "icon": "media/icon.png",
  "description": "ETL scratchpad and offline dev toolbox for VS Code",
  "publisher": "chakri68",
  "repository": {
    "url": "https://github.com/chakri68/jscratch/"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "etl",
    "json",
    "csv",
    "base64",
    "jwt",
    "uuid",
    "regex",
    "yaml",
    "toolbox"
  ],
  "activationEvents": [
    "onFileSystem:datalab"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "JScratch Settings",
      "properties": {
        "jscratch.pipeline.runOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run a transform when you save it."
        },
        "jscratch.pipeline.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Kill a transform after this many milliseconds."
        },
        "jscratch.pipeline.defaultOutputFormat": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson",
            "txt"
          ],
          "default": "json",
          "description": "Output format for transforms that don't set their own."
        },
        "jscratch.preview.maxRows": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "description": "Maximum rows sent to the data preview."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jscratch-explorer",
          "title": "JScratch",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "jscratch-explorer": [
        {
          "id": "jscratch.pipelineView",
          "name": "Active Session"
        },
        {
          "id": "jscratch.toolboxView",
          "name": "Toolbox"
        },
        {
          "id": "jscratch.historyView",
          "name": "History"
        }
      ]
    },
    "commands": [
      {
        "command": "jscratch.newSession",
        "title": "New Session",
        "category": "JScratch",
        "icon": "$(add)"
      },
      {
        "command": "jscratch.loadSession",
        "title": "Load Session",
        "category": "JScratch",
        "icon": "$(folder-opened)"
      },
      {
        "command": "jscratch.deleteSession",
        "title": "Delete Session",
        "category": "JScratch",
        "icon": "$(trash)"
      },
      {
        "command": "jscratch.addInput",
        "title": "Add Input",
        "category": "JScratch",
        "icon": "$(file-add)"
      },
      {
        "command": "jscratch.addTransform",
        "title": "Add Transform",
        "category": "JScratch",
        "icon": "$(beaker)"
      },
      {
        "command": "jscratch.runTransform",
        "title": "Run Current Transform",
        "category": "JScratch",
        "icon": "$(play)"
      },
      {
        "command": "jscratch.runBranch",
        "title": "Run Branch",
        "category": "JScratch",
        "icon": "$(run-all)"
      },
      {
        "command": "jscratch.setOutputFormat",
        "title": "Set Output Format",
        "category": "JScratch",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "jscratch.exportFile",
        "title": "Export File",
        "category": "JScratch",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "jscratch.clearHistory",
        "title": "Clear History",
        "category": "JScratch",
        "icon": "$(clear-all)"
      },
      {
        "command": "jscratch.openToolbox",
        "title": "Open Toolbox",
        "category": "JScratch",
        "icon": "$(tools)"
      },
      {
        "command": "jscratch.preview",
        "title": "Preview Current File",
        "category": "JScratch",
        "icon": "$(table)"
      },
      {
        "command": "jscratch.deleteNode",
        "title": "Delete",
        "category": "JScratch",
        "icon": "$(trash)"
      },
      {
        "command": "jscratch.reloadTypes",
        "title": "Reload Types",
        "category": "JScratch",
        "icon": "$(refresh)"
      },
      {
        "command": "jscratch.createInput",
        "title": "Add Input (alias)",
        "category": "JScratch",
        "icon": "$(add)"
      },
      {
        "command": "jscratch.openTool",
        "title": "Open Tool…",
        "category": "JScratch",
        "icon": "$(search)"
      },
      {
        "command": "jscratch.quick.base64.0",
        "title": "Base64 Encode",
        "category": "JScratch"
      },
      {
        "command": "jscratch.quick.base64.1",
        "title": "Base64 Decode",
        "category": "JScratch"
      },
      {
        "command": "jscratch.quick.url.0",
        "title": "URL Encode",
        "category": "JScratch"
      },
      {
        "command": "jscratch.quick.url.1",
        "title": "URL Decode",
        "category": "JScratch"
      },
      {
        "command": "jscratch.quick.jwt.0",
        "title": "Decode JWT",
        "category": "JScratch"
      },
      {
        "command": "jscratch.quick.json-format.0",
        "title": "Format JSON",
        "category": "JScratch"
      },
      {
        "command": "jscratch.quick.json-format.1",
        "title": "Minify JSON",
        "category": "JScratch"
      },
      {
        "command": "jscratch.quick.json-yaml.0",
        "title": "JSON → YAML",
        "category": "JScratch"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jscratch.newSession",
          "when": "view == jscratch.pipelineView",
          "group": "navigation"
        },
        {
          "command": "jscratch.addInput",
          "when": "view == jscratch.pipelineView && jscratch.hasSession",
          "group": "navigation"
        },
        {
          "command": "jscratch.clearHistory",
          "when": "view == jscratch.historyView",
          "group": "navigation"
        },
        {
          "command": "jscratch.openToolbox",
          "when": "view == jscratch.toolboxView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jscratch.addTransform",
          "when": "view == jscratch.pipelineView && viewItem == input",
          "group": "inline@1"
        },
        {
          "command": "jscratch.addTransform",
          "when": "view == jscratch.pipelineView && viewItem == output",
          "group": "inline@1"
        },
        {
          "command": "jscratch.exportFile",
          "when": "view == jscratch.pipelineView && (viewItem == input || viewItem == output)",
          "group": "inline@2"
        },
        {
          "command": "jscratch.preview",
          "when": "view == jscratch.pipelineView && (viewItem == input || viewItem == output)",
          "group": "inline@3"
        },
        {
          "command": "jscratch.deleteSession",
          "when": "view == jscratch.historyView && viewItem == session",
          "group": "inline"
        },
        {
          "command": "jscratch.deleteNode",
          "when": "view == jscratch.pipelineView && viewItem == transform",
          "group": "inline@9"
        },
        {
          "command": "jscratch.deleteNode",
          "when": "view == jscratch.pipelineView && viewItem == input",
          "group": "9_delete"
        },
        {
          "command": "jscratch.deleteNode",
          "when": "view == jscratch.pipelineView && viewItem == output",
          "group": "9_delete"
        },
        {
          "command": "jscratch.reloadTypes",
          "when": "view == jscratch.pipelineView && viewItem == transform",
          "group": "inline@3"
        },
        {
          "command": "jscratch.runTransform",
          "when": "view == jscratch.pipelineView && viewItem == transform",
          "group": "inline@1"
        },
        {
          "command": "jscratch.runBranch",
          "when": "view == jscratch.pipelineView && viewItem == transform",
          "group": "inline@2"
        },
        {
          "command": "jscratch.setOutputFormat",
          "when": "view == jscratch.pipelineView && viewItem == transform",
          "group": "2_format"
        }
      ],
      "commandPalette": [
        {
          "command": "jscratch.loadSession",
          "when": "false"
        },
        {
          "command": "jscratch.deleteSession",
          "when": "false"
        },
        {
          "command": "jscratch.createInput",
          "when": "false"
        },
        {
          "command": "jscratch.addTransform",
          "when": "false"
        },
        {
          "command": "jscratch.runBranch",
          "when": "false"
        },
        {
          "command": "jscratch.setOutputFormat",
          "when": "false"
        },
        {
          "command": "jscratch.exportFile",
          "when": "false"
        },
        {
          "command": "jscratch.deleteNode",
          "when": "false"
        },
        {
          "command": "jscratch.reloadTypes",
          "when": "false"
        },
        {
          "command": "jscratch.quick.base64.0",
          "when": "false"
        },
        {
          "command": "jscratch.quick.base64.1",
          "when": "false"
        },
        {
          "command": "jscratch.quick.url.0",
          "when": "false"
        },
        {
          "command": "jscratch.quick.url.1",
          "when": "false"
        },
        {
          "command": "jscratch.quick.jwt.0",
          "when": "false"
        },
        {
          "command": "jscratch.quick.json-format.0",
          "when": "false"
        },
        {
          "command": "jscratch.quick.json-format.1",
          "when": "false"
        },
        {
          "command": "jscratch.quick.json-yaml.0",
          "when": "false"
        },
        {
          "command": "jscratch.preview",
          "when": "resourceExtname =~ /\\.(json|csv|jsonl|ndjson|txt)$/"
        },
        {
          "command": "jscratch.runTransform",
          "when": "resourceScheme == datalab && resourceExtname == .ts"
        }
      ],
      "editor/context": [
        {
          "submenu": "jscratch.editorSubmenu",
          "when": "editorHasSelection",
          "group": "9_jscratch"
        }
      ],
      "jscratch.editorSubmenu": [
        {
          "command": "jscratch.quick.base64.0",
          "group": "quick"
        },
        {
          "command": "jscratch.quick.base64.1",
          "group": "quick"
        },
        {
          "command": "jscratch.quick.url.0",
          "group": "quick"
        },
        {
          "command": "jscratch.quick.url.1",
          "group": "quick"
        },
        {
          "command": "jscratch.quick.jwt.0",
          "group": "quick"
        },
        {
          "command": "jscratch.quick.json-format.0",
          "group": "quick"
        },
        {
          "command": "jscratch.quick.json-format.1",
          "group": "quick"
        },
        {
          "command": "jscratch.quick.json-yaml.0",
          "group": "quick"
        }
      ],
      "editor/title": [
        {
          "command": "jscratch.preview",
          "when": "resourceScheme == datalab && resourceExtname =~ /\\.(json|csv|jsonl|ndjson|txt)$/",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jscratch.pipelineView",
        "contents": "No active session.\n[New Session](command:jscratch.newSession)\nOr open the [Toolbox](command:jscratch.openToolbox) for quick dev utilities.",
        "when": "!jscratch.hasSession"
      },
      {
        "view": "jscratch.pipelineView",
        "contents": "This session is empty.\n[Add Input](command:jscratch.addInput)",
        "when": "jscratch.hasSession && jscratch.sessionEmpty"
      }
    ],
    "submenus": [
      {
        "id": "jscratch.editorSubmenu",
        "label": "JScratch"
      }
    ],
    "keybindings": [
      {
        "command": "jscratch.openTool",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && tsc -p tsconfig.test.json && node ./out/test/integration/runTest.js",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "tsx --test \"test/unit/**/*.test.ts\"",
    "icons": "node scripts/render-icon.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.x",
    "@types/papaparse": "^5.5.2",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^2.3.2",
    "@vscode/vsce": "^3.7.1",
    "cronstrue": "^3.32.0",
    "eslint": "^8.39.0",
    "glob": "^8.1.0",
    "jsonpath-plus": "^11.2.1",
    "mocha": "^10.2.0",
    "papaparse": "^5.7.0",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.1.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "esbuild": "^0.27.2"
  }
}
